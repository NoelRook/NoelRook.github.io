---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThreeBackdrop from "../components/ThreeBackdrop.astro";
import {
  aboutParagraphs,
  interests,
  nowExploring,
  profile,
  projects,
  skillGroups,
  timeline
} from "../data/resume";
---

<BaseLayout
  title={`${profile.name} | ${profile.role}`}
  description="Portfolio of Jing Kang, a CS student and builder focused on full-stack systems, problem solving, and experimental web projects."
>
  <ThreeBackdrop />

  <div class="bg-layer" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <span class="blob blob-c"></span>
    <span class="grain"></span>
  </div>

  <main>
    <nav class="floating-nav reveal" aria-label="Primary navigation">
      <a href="#about">About</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#experience">Experience</a>
      <a href="#now">Now</a>
      <a href="#contact">Contact</a>
    </nav>

    <header class="hero reveal" id="hero" data-nav="about">
      <div class="hero-left">
        <p class="kicker">{profile.role}</p>
        <h1>{profile.name}</h1>
        <p class="tagline">{profile.tagline}</p>
        <p class="intro-copy">{profile.intro}</p>
        <div class="hero-actions">
          <a href="#projects">View Projects</a>
          <a href={profile.github} target="_blank" rel="noreferrer" class="secondary">GitHub</a>
        </div>
      </div>

      <div class="hero-right">
        <button id="modeToggle" class="mode-toggle" type="button">Toggle Terminal Mode</button>
        <div class="terminal-card" role="status" aria-live="polite">
          <p class="terminal-title">~/jingkang/portfolio</p>
          <p class="terminal-hint">Try command: <strong>help</strong></p>
          <p id="typingLine" class="typing-line"></p>
          <div id="terminalHistory" class="terminal-history" aria-live="polite"></div>
          <label class="sr-only" for="terminalInput">Terminal command</label>
          <div class="terminal-input-row">
            <span class="prompt-mark" aria-hidden="true">$</span>
            <input id="terminalInput" class="terminal-input" type="text" autocomplete="off" spellcheck="false" placeholder="type here" />
          </div>
        </div>
      </div>
    </header>

    <section class="panel reveal" id="about" data-nav="about">
      <p class="section-kicker">ABOUT ME</p>
      <h2>I build real things, not just coursework.</h2>
      {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="interest-row">
        {interests.map((interest) => <span>{interest}</span>)}
      </div>
    </section>

    <section class="panel reveal" id="projects" data-nav="projects">
      <p class="section-kicker">PROJECTS</p>
      <h2>Built in the real world, not tutorial-land.</h2>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="stack-list">
              {project.stack.map((tech) => <li>{tech}</li>)}
            </ul>
            <div class="project-links">
              <a href={project.github} target="_blank" rel="noreferrer">GitHub</a>
              {project.demo ? (
                <a href={project.demo} target="_blank" rel="noreferrer">Live Demo</a>
              ) : (
                <a href={project.github} target="_blank" rel="noreferrer">Preview</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="panel reveal" id="skills" data-nav="skills">
      <p class="section-kicker">SKILLS</p>
      <h2>Clean toolkit. No fake skill bars.</h2>
      <div class="skill-groups">
        {skillGroups.map((group) => (
          <article class="skill-card">
            <h3>{group.title}</h3>
            <ul class="chips">
              {group.items.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="panel reveal" id="experience" data-nav="experience">
      <p class="section-kicker">EXPERIENCE</p>
      <h2>Impact over fluff.</h2>
      {timeline.map((item) => (
        <article class="timeline-item">
          <div class="timeline-head">
            <h3>{item.role}</h3>
            <p>{item.subtitle}</p>
            <p>{item.period}</p>
          </div>
          <p>{item.impact}</p>
        </article>
      ))}
    </section>

    <section class="panel reveal" id="now" data-nav="now">
      <p class="section-kicker">NOW</p>
      <h2>What I am currently exploring</h2>
      <ul class="now-list">
        {nowExploring.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="panel reveal final-cta" id="contact" data-nav="contact">
      <p class="section-kicker">CONTACT</p>
      <h2>If you are building something interesting, let’s talk.</h2>
      <p>
        I am always open to projects that involve hard problems, clean engineering,
        and good people.
      </p>
      <div class="contact-links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </section>
  </main>

  <script>
    const revealItems = document.querySelectorAll(".reveal");
    const sections = Array.from(document.querySelectorAll("main [data-nav]"));
    const navLinks = Array.from(document.querySelectorAll(".floating-nav a"));
    const terminalInput = document.querySelector("#terminalInput");
    const terminalHistory = document.querySelector("#terminalHistory");
    const typingLine = document.querySelector("#typingLine");
    const modeToggle = document.querySelector("#modeToggle");
    const body = document.body;

    console.log("👀 snooping around? You will fit right in.");

    const bugToast = document.createElement("div");
    bugToast.className = "bug-toast";
    bugToast.textContent = "Warning: Hello world.";
    document.body.appendChild(bugToast);
    setTimeout(() => bugToast.classList.add("show"), 900);
    setTimeout(() => bugToast.classList.remove("show"), 4200);

    const lines = [
      "npm run build",
      "git push origin main",
      "solving hard bugs since coffee #1"
    ];
    let lineIndex = 0;
    let charIndex = 0;

    const typeLoop = () => {
      if (!(typingLine instanceof HTMLElement)) return;
      const current = lines[lineIndex];
      typingLine.textContent = `$ ${current.slice(0, charIndex)}`;

      if (charIndex < current.length) {
        charIndex += 1;
        setTimeout(typeLoop, 55);
      } else {
        setTimeout(() => {
          charIndex = 0;
          lineIndex = (lineIndex + 1) % lines.length;
          typeLoop();
        }, 1100);
      }
    };
    typeLoop();

    const applyMode = (isTerminal) => {
      body.classList.toggle("terminal-mode", isTerminal);
      localStorage.setItem("jk_terminal_mode", String(isTerminal));
      if (modeToggle instanceof HTMLButtonElement) {
        modeToggle.textContent = isTerminal ? "Exit Terminal Mode" : "Toggle Terminal Mode";
      }
    };

    const storedMode = localStorage.getItem("jk_terminal_mode") === "true";
    applyMode(storedMode);

    if (modeToggle instanceof HTMLButtonElement) {
      modeToggle.addEventListener("click", () => {
        applyMode(!body.classList.contains("terminal-mode"));
      });
    }

    const setActiveNav = (key) => {
      navLinks.forEach((link) => {
        const hrefTarget = link.getAttribute("href")?.replace("#", "") ?? "";
        link.classList.toggle("is-active", hrefTarget === key);
      });
    };

    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.15,
          rootMargin: "0px 0px -10% 0px"
        }
      );

      revealItems.forEach((item, index) => {
        if (item instanceof HTMLElement) {
          item.style.transitionDelay = `${Math.min(index * 90, 320)}ms`;
        }
        revealObserver.observe(item);
      });

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const navKey = entry.target.getAttribute("data-nav") || "about";
              setActiveNav(navKey);
            }
          });
        },
        {
          threshold: 0.32,
          rootMargin: "-20% 0px -45% 0px"
        }
      );

      sections.forEach((section) => sectionObserver.observe(section));
      setActiveNav("about");
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }

    const commandHistory = [];
    let historyCursor = -1;

    const pushHistoryEntry = (text, type = "output") => {
      if (!(terminalHistory instanceof HTMLElement)) return;

      const row = document.createElement("p");
      row.className = `terminal-entry ${type}`;
      row.textContent = text;
      terminalHistory.appendChild(row);

      while (terminalHistory.children.length > 18) {
        terminalHistory.removeChild(terminalHistory.firstChild);
      }

      terminalHistory.scrollTop = terminalHistory.scrollHeight;
    };

    pushHistoryEntry("Booting portfolio shell...", "meta");
    pushHistoryEntry("Type help to list available commands.", "meta");

    const runCommand = (command) => {
      if (command === "help") {
        pushHistoryEntry("commands: help | whoami | sudo hire jingkang | clear", "output");
      } else if (command === "whoami") {
        pushHistoryEntry("Jing Kang - CS student, builder, and occasional bug hunter.", "output");
      } else if (command === "sudo hire jingkang") {
        pushHistoryEntry("permission granted. preparing clean code and coffee.", "success");
        body.classList.add("easter-armed");
        setTimeout(() => body.classList.remove("easter-armed"), 1200);
      } else if (command === "clear") {
        if (terminalHistory instanceof HTMLElement) {
          terminalHistory.innerHTML = "";
        }
        pushHistoryEntry("history cleared.", "meta");
      } else if (command.length === 0) {
        pushHistoryEntry("Tip: type help", "meta");
      } else {
        pushHistoryEntry(`command not found: ${command}`, "error");
      }
    };

    if (terminalInput instanceof HTMLInputElement) {
      terminalInput.addEventListener("keydown", (event) => {
        if (event.key === "ArrowUp") {
          event.preventDefault();
          if (commandHistory.length === 0) return;
          historyCursor = Math.min(historyCursor + 1, commandHistory.length - 1);
          terminalInput.value = commandHistory[commandHistory.length - 1 - historyCursor];
          return;
        }

        if (event.key === "ArrowDown") {
          event.preventDefault();
          if (historyCursor <= 0) {
            historyCursor = -1;
            terminalInput.value = "";
            return;
          }
          historyCursor -= 1;
          terminalInput.value = commandHistory[commandHistory.length - 1 - historyCursor];
          return;
        }

        if (event.key !== "Enter") return;

        const command = terminalInput.value.trim().toLowerCase();
        pushHistoryEntry(`$ ${command || ""}`, "command");

        if (command.length > 0) {
          commandHistory.push(command);
          if (commandHistory.length > 40) {
            commandHistory.shift();
          }
        }

        runCommand(command);
        historyCursor = -1;
        terminalInput.value = "";
      });
    }
  </script>
</BaseLayout>
